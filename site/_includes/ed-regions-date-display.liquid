<div class="sub-partial-output">
  <p><em>{{ label }}</em></p>
  <dl>
    <dt>date | dateToRfc3339</dt><dd>{{ date | dateToRfc3339 }}</dd>
    <dt>date | dateToRfc822</dt><dd>{{ date | dateToRfc822 }}</dd>
    <dt>date | htmlDateString</dt><dd>{{ date | htmlDateString }}</dd>
    <dt>date | postDate</dt><dd>{{ date | postDate }}</dd>
  </dl>
</div>
